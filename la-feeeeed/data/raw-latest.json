          "likeCount": 10,
          "retweetCount": 9,
          "replyCount": 0,
          "viewCount": 2910,
          "quoteCount": 0,
          "bookmarkCount": 1,
          "media": [
            {
              "id": "1712487263647727616",
              "type": "video",
              "url": "https://video.twimg.com/ext_tw_video/1712487263647727616/pu/vid/avc1/720x720/zEHRgeR8GuKDy9oS.mp4?tag=12",
              "previewImageUrl": "https://pbs.twimg.com/ext_tw_video_thumb/1712487263647727616/pu/img/ig2aryXEnZEv1iQY.jpg"
