          "inReplyToId": null,
          "author": {
            "id": "1022564507971801088",
            "username": "UnrigLA",
            "name": "Unrig LA",
            "verified": false,
            "followersCount": 16597,
            "profileImageUrl": "https://pbs.twimg.com/profile_images/1179148691996721152/z38zFDv5_normal.jpg"
          },
          "likeCount": 64,
          "retweetCount": 7,
          "replyCount": 2,
          "viewCount": 3076,
          "quoteCount": 0,
          "bookmarkCount": 8,
          "media": [],
          "entities": {
            "hashtags": [],
            "mentions": [],
            "urls": []
          },
          "article": null,
          "quotedPost": {
            "id": "2125805419381530904",
            "text": "I told you. This is just the tip of the iceberg. A lot of the political consultants want you to lose. The Police Union spent millions doing ads against me in the primary, then they were freaking out and spent millions trying to beat Raman. It's all a grift. https://t.co/29qc22X0no",
